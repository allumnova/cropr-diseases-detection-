# AgroGuard HBTU — Environment Configuration
# Copy to .env.local for local overrides

# Device authentication key shared with ESP32 & ESP32-CAM firmware
AGROGUARD_DEVICE_KEY=hbtu-agroguard-2026

# NextAuth v5 Secret (generate a strong random string in production)
AUTH_SECRET=hbtu-ee-final-year-project-2026-secret-key

# Optional: External MQTT Broker (defaults to mqtt://localhost:1883 in worker)
MQTT_BROKER_URL=mqtt://localhost:1883
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: PostgreSQL / TimescaleDB Connection (uses ./data/agroguard-db.json if unset)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agroguard

# Python FastAPI CNN Inference Service (http://localhost:8000 locally or http://ai-service:8000 in Docker)
AI_SERVICE_URL=http://localhost:8000

# Optional: OpenAI / Gemini Vision API Keys for Hybrid LLM + Sensor Reasoning
# OPENAI_API_KEY=
# GEMINI_API_KEY=
